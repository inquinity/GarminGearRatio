<?xml version="1.0"?>
<properties>
    <!-- ── Which screen to render ───────────────────────────────────────────
         Mirrors the DisplayMode enum in Di2StepsView.mc:
           0 = RIDE        gear / ratio (rider-facing)
           1 = GEAR_CONFIG drivetrain topology + tooth counts
           2 = TEST        name/value table of every field (diagnostics)
         Defaults to TEST while we are still proving the numbers are right. -->
    <property id="DisplayMode" type="Number">2</property>

    <!-- ── Drivetrain tooth counts (user-entered) ───────────────────────────
         These MUST be entered by hand. Activity.Info does expose teeth via
         frontDerailleurSize / rearDerailleurSize, but on the SC-EM800 they are
         unusable: the rear reports a constant 12 regardless of gear, and the
         front reports 0. Only the POSITION fields track shifts. Verified
         on-device 2026-08-09 — see docs/project.md.

         Enter teeth as CSV. Rear position 1 is the EASIEST gear — the largest
         cog — confirmed on this bike 2026-08-09. Rear values are sorted
         largest-first on load, so entry order does not matter and cannot
         silently produce an inverted ratio.

         Ebikes are usually 1x, so FrontRings is normally 1 and FrontTeeth is a
         single value. Rear cog COUNT is known live (rearDerailleurMax), so it
         is not configured here — only the tooth values are.                  -->
    <property id="FrontRings" type="Number">1</property>
    <property id="FrontTeeth" type="String"></property>
    <property id="RearTeeth"  type="String"></property>

    <!-- Written by the data field whenever Activity.Info reports
         rearDerailleurMax; read by the on-device wizard so it can pre-mark the
         detected cassette size. The wizard normally runs with no activity
         recording, when Activity.Info has nothing live to offer. Not shown in
         the settings UI — it is a cache, not a preference.                    -->
    <property id="LastRearMax" type="Number">0</property>
</properties>
