<?xml version="1.0"?>
<properties>
    <!-- ── Which screen to render ───────────────────────────────────────────
         Mirrors the DisplayMode enum in Di2StepsView.mc:
           0 = RIDE        gear / ratio / assist mode (replaces a Di2 page)
           1 = GEAR_CONFIG drivetrain topology + tooth counts
           2 = TEST        name/value table of every decoded field (diagnostics)
         Defaults to TEST while we are still proving data retrieval end-to-end. -->
    <property id="DisplayMode" type="Number">2</property>

    <!-- RESERVED — declared and shown in settings, but no source file reads it.
         Intended: write raw BLE packets into the FIT file for after-the-ride
         debugging (Stage 5). Off by default so it costs no memory/battery.    -->
    <property id="Debug" type="Boolean">false</property>

    <!-- ── Drivetrain ───────────────────────────────────────────────────────
         RESERVED — declared and shown in settings, but no source file reads
         these yet. Ebikes are usually 1x. Rear cog COUNT is known live (max
         gear from the BLE stream, and rearDerailleurMax from Activity.Info).

         Whether the tooth VALUES must be user-entered is currently under test:
         Activity.Info also exposes frontDerailleurSize/rearDerailleurSize in
         teeth. If those return real values on this bike, these three settings
         are unnecessary and should be removed; if they return null (expected,
         given Garmin's own Gear Ratio field renders blank), they get wired up
         and GarminGearRatio's GearConfig.mc parsing is the thing to reuse.    -->
    <property id="FrontRings" type="Number">1</property>
    <property id="FrontTeeth" type="String"></property>
    <property id="RearTeeth"  type="String"></property>

    <!-- ── Bike identity ────────────────────────────────────────────────────
         LastMAC is stored automatically after first connect. Enable LastLock
         to only ever reconnect to that saved bike.                            -->
    <property id="LastLock" type="Boolean">false</property>
    <property id="LastMAC"  type="String"></property>
</properties>
