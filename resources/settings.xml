<?xml version="1.0"?>
<settings>
    <setting propertyKey="@Properties.DisplayMode" title="@Strings.DisplayModeTitle">
        <!-- Ride only. Gear Config (1) is an unimplemented stub, and
             Test (2) is a name/value diagnostic table that confused riders who
             met it without context. Both stay reachable in the source; neither
             belongs in a shipped settings list. -->
        <settingConfig type="list">
            <listEntry value="0">Ride</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.FrontRings" title="@Strings.FrontRingsTitle">
        <settingConfig type="numeric" min="1" max="2"/>
    </setting>
    <setting propertyKey="@Properties.FrontTeeth" title="@Strings.FrontTeethTitle">
        <settingConfig type="alphaNumeric"/>
    </setting>
    <setting propertyKey="@Properties.RearTeeth" title="@Strings.RearTeethTitle">
        <settingConfig type="alphaNumeric"/>
    </setting>
</settings>
